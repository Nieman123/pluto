# Copy to .env.local for the isolated local ticketing preview.
# Application secrets belong in .secret.local / Google Secret Manager.
TICKETING_MODE=test
TICKETING_BASE_URL=http://127.0.0.1:4173
STRIPE_PUBLISHABLE_KEY=
STRIPE_ACCOUNT_ID=acct_1UMDWoDELViA2aSQ
STRIPE_PAYMENT_METHOD_CONFIGURATION=
TICKETING_EMAIL_FROM=Pluto Events <tickets@pluto.events>
TICKETING_STORAGE_BUCKET=demo-pluto-ticketing.appspot.com
# Enable only after live account, bank, taxes and production webhook are ready.
TICKETING_LIVE_READY=false
# Leave empty for direct/local requests. Configure observed proxy IPs/subnets only
# after the staging procedure in docs/ticketing-proxy-acceptance.md passes.
TICKETING_TRUSTED_PROXIES=
