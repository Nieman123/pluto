{% extends 'base.njk' %}
{% block content %}
<link rel="stylesheet" href="/assets/ticketing.css?v={{ assetVersion }}">
<section class="section events-discovery"><div class="discovery-heading"><p class="eyebrow">PLUTO PRESENTS · MUSIC & COMMUNITY</p>{% if past %}<h1>Nights<br><span>we’ve shared.</span></h1><p>A look back at past Pluto gatherings.</p>{% else %}<h1>Find your<br><span>next night.</span></h1><p>Good sound. Familiar faces. Something worth showing up for.</p>{% endif %}</div>
<div class="discover-grid">{% for event in events %}<article class="discover-card">
<div class="discover-artwork"><a class="discover-art" href="/events/{{ event.slug }}" tabindex="-1" aria-hidden="true">
{% if event.hero %}<img src="/events/{{ event.slug }}/media/{{ event.hero.assetId }}" alt="" loading="lazy" style="object-position:{{ event.hero.focalX }}% {{ event.hero.focalY }}%">{% elif event.flyer %}<img src="/events/{{ event.slug }}/media/{{ event.flyer.assetId }}" alt="" loading="lazy">{% else %}<div class="discover-placeholder"><span aria-hidden="true">✦</span><span>PLUTO PRESENTS</span></div>{% endif %}
<span class="status-pill discover-status">{{ event.saleLabel }}</span></a>
{% if event.flyer %}<a class="discover-flyer" href="/events/{{ event.slug }}/media/{{ event.flyer.assetId }}" target="_blank" rel="noopener" aria-label="View full flyer for {{ event.title }}"><img src="/events/{{ event.slug }}/media/{{ event.flyer.assetId }}" alt="{{ event.flyer.alt or 'Event flyer' }}" loading="lazy"></a>{% endif %}</div>
<div class="discover-body"><p class="discover-date">{{ event.dateLabel }}</p><h2><a href="/events/{{ event.slug }}">{{ event.title }}</a></h2><p class="discover-intro">{{ event.subtitle }}</p><div class="discover-footer"><span>{{ event.city }}, {{ event.region }}</span><a class="discover-action" href="/events/{{ event.slug }}">{% if not past and event.status == 'published' and event.registrationMode != 'free' %}{% if event.registrationMode == 'rsvp' or event.registrationMode == 'rsvp-approval' %}View event & RSVP{% else %}View event & tickets{% endif %}{% else %}View event{% endif %}<span aria-hidden="true">↗</span></a></div></div>
</article>{% else %}<div class="empty-state"><span class="empty-orbit" aria-hidden="true">✦</span>{% if past %}<h2>Our next memories are ahead.</h2><p>Completed events will appear here.</p>{% else %}<h2>The next night is on its way.</h2><p>New gatherings are taking shape. Keep an eye on Pluto for the next announcement.</p><a class="button button-quiet" href="/links">Stay connected ↗</a>{% endif %}</div>{% endfor %}</div>
<nav class="discover-history-link" aria-label="More events">{% if past %}<a class="button button-quiet" href="/events">Explore upcoming events <span aria-hidden="true">↗</span></a>{% else %}<a class="button button-quiet" href="/past-events">View past events <span aria-hidden="true">↗</span></a>{% endif %}</nav>
</section>
{% endblock %}
