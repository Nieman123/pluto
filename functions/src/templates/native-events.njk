{% extends 'base.njk' %}
{% block content %}
<link rel="stylesheet" href="/assets/ticketing.css">
<section class="section events-discovery"><div class="discovery-heading"><p class="eyebrow">PLUTO PRESENTS · MUSIC & COMMUNITY</p><h1>Find your<br><span>next night.</span></h1><p>Good sound. Familiar faces. Something worth showing up for.</p></div>
<div class="discover-grid">{% for event in events %}<article class="discover-card">
<a class="discover-art" href="/events/{{ event.slug }}" tabindex="-1" aria-hidden="true">
{% if event.hero %}<img src="/events/{{ event.slug }}/media/{{ event.hero.assetId }}" alt="" loading="lazy" style="object-position:{{ event.hero.focalX }}% {{ event.hero.focalY }}%">{% elif event.flyer %}<img src="/events/{{ event.slug }}/media/{{ event.flyer.assetId }}" alt="" loading="lazy">{% else %}<div class="discover-placeholder"><span aria-hidden="true">✦</span><span>PLUTO PRESENTS</span></div>{% endif %}
<span class="status-pill discover-status">{{ event.saleLabel }}</span></a>
<div class="discover-body"><p class="discover-date">{{ event.dateLabel }}</p><h2><a href="/events/{{ event.slug }}">{{ event.title }}</a></h2><p class="discover-intro">{{ event.subtitle }}</p><div class="discover-footer"><span>{{ event.city }}, {{ event.region }}</span><a class="discover-action" href="/events/{{ event.slug }}">{% if event.status == 'published' %}View event & tickets{% else %}View event{% endif %}<span aria-hidden="true">↗</span></a></div></div>
</article>{% else %}<div class="empty-state"><span class="empty-orbit" aria-hidden="true">✦</span><h2>The next night is on its way.</h2><p>New gatherings are taking shape. Keep an eye on Pluto for the next announcement.</p><a class="button button-quiet" href="/links">Stay connected ↗</a></div>{% endfor %}</div>
</section>
{% endblock %}
