{% extends 'base.njk' %}
{% block content %}
<link rel="stylesheet" href="/assets/ticketing.css">
<section class="section ticketing-console" data-ticketing-console="{{ mode }}">
<p class="eyebrow">PLUTO EVENTS {% if sandbox %} · SANDBOX{% endif %}</p>{% if mode == 'admin' %}<h1 class="admin-sr-only">Event administration</h1>{% else %}<h1>{% if mode == 'staff' %}At the door.{% else %}Your tickets.{% endif %}</h1>{% endif %}
<div class="ticket-toolbar">{% if mode != 'admin' %}<a class="button button-quiet" href="/events">Explore events</a><a class="button button-quiet" href="/tickets">My tickets</a>{% endif %}{% if mode == 'admin' %}<button id="events-back" class="button button-quiet" type="button" hidden>View all Events</button>{% elif mode != 'customer' %}<a class="button button-quiet" href="/tickets/admin">View all Events</a>{% endif %}{% if mode != 'customer' %}<a class="button button-quiet" href="/tickets/staff">Admission</a>{% endif %}</div>
<p id="ticketing-message" role="status" aria-live="polite">{% if mode == 'staff' %}Enter the scanner PIN from your event organizer, or sign in with your staff account.{% elif mode != 'customer' %}Sign in with your Pluto staff account to continue.{% else %}Open your secure email link, or sign in to see your orders.{% endif %}</p>
{% if mode == 'staff' %}
<div id="scanner-login" class="scanner-login"><p class="eyebrow">DOOR ACCESS</p><h2>Ticket Scanner PIN</h2><p>Your organizer’s PIN gives you access to scan tickets for one event.</p><form id="scanner-login-form"><label for="scanner-pin">8-digit PIN<input id="scanner-pin" name="pin" inputmode="numeric" autocomplete="off" maxlength="12" required pattern="[0-9\s\-]{8,12}" placeholder="0000 0000" aria-describedby="scanner-pin-help"></label><p id="scanner-pin-help">No account needed. Enter your PIN while online before opening the doors.</p><button class="button button-primary" type="submit">Start scanning</button></form></div>
<div id="scanner-session" class="scanner-session" hidden><div><p class="eyebrow">SCANNER ACCESS</p><h2 id="scanner-event-title"></h2><p id="scanner-session-label"></p></div><button id="scanner-logout" class="button button-quiet" type="button">End scanner session</button></div>
{% endif %}
<div id="ticketing-auth"><div data-auth-signed-out><a class="button button-primary" href="/app/sign-on">{% if mode == 'staff' %}Staff account sign in{% else %}Sign in{% endif %}</a></div></div>
{% if mode == 'customer' %}
<form id="ticket-recovery-form"><h2>Find your tickets</h2><label>Email address <input type="email" name="email" autocomplete="email" required></label><button class="button button-primary">Email me a secure link</button></form>
<button id="ticket-claim" class="button button-quiet" hidden>Claim orders with my verified email</button><div id="customer-orders"></div>
{% else %}
<div id="staff-controls" hidden><label {% if mode == 'admin' %}class="event-switcher" hidden{% endif %}>Event <select id="staff-event"><option value="">Select an event</option></select></label>
{% if mode == 'admin' %}
<div id="events-index"><div class="workspace-heading"><div><h2>Make the next gathering happen.</h2><p>Choose an event to see orders, sales and inventory.</p></div><button id="event-new" class="button button-primary">+ Create event</button></div><section id="weekly-revenue" aria-label="Weekly event revenue" hidden></section><div id="event-list" class="admin-event-grid"></div></div>
<div id="event-workspace" hidden><div class="workspace-heading"><div><h2 id="workspace-title"></h2><span id="workspace-status" class="status-pill"></span></div><div class="ticket-toolbar"><a id="event-public-page" class="button button-quiet" target="_blank" rel="noopener" hidden>View Public Page ↗</a><button id="event-studio" class="button button-primary">Event studio ↗</button><button id="event-orders" class="button button-quiet">← Event dashboard</button><button id="event-cash" class="button button-quiet">Cash sale / comp</button><button id="event-scanner-pins" class="button button-quiet">Scanner PINs</button><button id="event-roles" class="button button-quiet">Staff & promoters</button><button id="event-promoter-stats" class="button button-quiet" hidden>My promoter statistics</button></div></div><div id="event-editor" hidden></div><div id="event-dashboard"></div></div>
{% else %}
<div class="ticket-toolbar"><button id="admission-sync" class="button button-primary">Prepare offline admission</button><button id="admission-replay" class="button button-quiet">Sync queued scans</button><button id="admission-camera" class="button button-quiet">Start camera</button><button id="admission-manager-import" class="button button-quiet" hidden>Import queued scans for manager review</button></div>
<p id="admission-cache-status" role="status"></p><video id="admission-video" playsinline muted hidden></video>
<form id="admission-form"><label>Ticket QR content <textarea name="qr" required placeholder="Scan a ticket or paste its QR content"></textarea></label><button class="button button-primary">Check ticket</button></form><div id="admission-results" aria-live="polite"></div><section id="door-guestlist" aria-label="Event guest list" hidden></section>
{% endif %}</div>
{% endif %}
<dialog id="ticketing-dialog" aria-label="Pluto ticket tools"><button id="ticketing-dialog-close" class="button button-quiet" type="button">Close</button><div id="ticketing-dialog-content"></div></dialog>
</section>
<script src="/assets/ticketing.js" defer></script>
{% endblock %}
