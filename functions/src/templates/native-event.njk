{% extends 'base.njk' %}
{% block content %}
<link rel="stylesheet" href="/assets/ticketing.css">
<div class="native-event theme-{{ event.theme.preset }}" style="--event-accent:{{ event.theme.accent }};--event-accent-text:{{ accentText }};--event-font:'{{ event.theme.font }}'">
{% if preview %}<p class="ticket-notice">Private preview{% if not event.free %} · Registration is disabled{% endif %}</p>{% elif sandbox and not event.free %}<p class="ticket-notice">Sandbox event · {% if event.rsvp %}Test RSVPs only{% else %}Test payments only{% endif %}</p>{% endif %}
<section class="native-hero">
{% if event.hero %}<img class="native-hero-art" src="{{ event.hero.url }}" alt="{{ event.hero.alt }}" style="object-position:{{ event.hero.focalX }}% {{ event.hero.focalY }}%" fetchpriority="high">{% endif %}
<div class="native-hero-content"><p class="eyebrow">PLUTO PRESENTS · {{ state }}</p><h1>{{ event.title }}</h1><p class="native-subtitle">{{ event.subtitle }}</p><p>{{ dateLabel }}</p><p>{{ event.city }}, {{ event.region }}{% if event.venueName %} · {{ event.venueName }}{% endif %}</p>{% if event.venueVisibility == 'holders' %}<p class="native-location-notice">Private location · Exact venue &amp; directions are for {% if event.rsvp %}confirmed RSVP guests{% else %}ticket holders{% endif %} only.{% if event.locationRevealLabel %}<br>Location reveal: {{ event.locationRevealLabel }}{% endif %}</p>{% endif %}<a href="{% if event.free %}#event-info{% else %}#tickets{% endif %}" class="button button-primary">{% if event.free %}Plan your visit{% elif event.rsvp %}RSVP here{% else %}Explore tickets{% endif %} <span aria-hidden="true">↗</span></a></div>
</section>
<div class="native-layout"><div class="native-story">
{% if not preview %}<nav class="ticket-toolbar event-calendar" aria-label="Add event to calendar"><a class="button button-quiet" href="{{ event.calendar.ics }}">Add to Calendar</a><a class="button button-quiet" href="{{ event.calendar.google }}" target="_blank" rel="noopener">Google Calendar ↗</a></nav>{% endif %}
<section class="native-section"><p class="eyebrow">THE EXPERIENCE</p><h2>A night worth being there for.</h2><div class="rich-content">{{ event.descriptionHtml | safe }}</div>
{% if event.flyer %}<figure><img class="native-flyer" src="{{ event.flyer.url }}" alt="{{ event.flyer.alt }}" loading="lazy"><figcaption>{{ event.flyer.caption }}</figcaption></figure>{% endif %}</section>
{% if event.lineup.length %}<section class="native-section"><p class="eyebrow">THE SOUND</p><h2>On the lineup.</h2><div class="native-lineup">{% for artist in event.lineup %}<article>{% if artist.image %}<img src="{{ artist.image.url }}" alt="{{ artist.image.alt }}" loading="lazy">{% endif %}<h3>{{ artist.name }}</h3><p>{{ artist.genre }}</p><p>{{ artist.time }}</p></article>{% endfor %}</div></section>{% endif %}
{% for section in event.sections %}{% if section.visible %}<section class="native-section" id="section-{{ section.id }}"><h2>{{ section.title }}</h2><div class="rich-content">{{ section.bodyHtml | safe }}</div></section>{% endif %}{% endfor %}
{% if event.gallery.length %}<section class="native-section"><h2>Get a feel for it.</h2><div class="native-gallery">{% for photo in event.gallery %}<figure><a href="{{ photo.url }}" target="_blank" rel="noopener"><img src="{{ photo.url }}" alt="{{ photo.alt }}" style="object-position:{{ photo.focalX }}% {{ photo.focalY }}%" loading="lazy"></a><figcaption>{{ photo.caption }}</figcaption></figure>{% endfor %}</div></section>{% endif %}
<section class="native-section" id="getting-here"><h2>Getting here.</h2><p>{{ event.city }}, {{ event.region }}</p>{% if event.venueVisibility == 'holders' %}<p>The exact venue and directions are visible only to {% if event.rsvp %}confirmed RSVP guests{% else %}ticket holders{% endif %} in the Pluto app{% if event.locationRevealLabel %}, from {{ event.locationRevealLabel }}{% else %}{% if event.rsvp %} after confirmation{% else %} after purchase{% endif %}{% endif %}.</p>{% else %}<p>{{ event.venueName }}</p><p>{{ event.address }}</p><p class="preserve-lines">{{ event.directions }}</p>{% endif %}</section>
</div><aside class="ticket-panel" id="{% if event.free %}event-info{% else %}tickets{% endif %}" aria-labelledby="ticket-panel-label"><p class="eyebrow" id="ticket-panel-label">{% if event.free %}FREE ENTRY{% elif event.rsvp %}RSVP HERE{% else %}BUY TICKETS HERE{% endif %}</p><p>{{ state }}</p>
{% if event.free %}
{% if state == 'Cancelled' %}<h2>This event has been cancelled.</h2>{% elif state == 'Past event' %}<h2>This event has ended.</h2>{% else %}<h2>Just show up.</h2><p>Free entry — no ticket or RSVP required. Bring your friends and join us.</p>{% endif %}
<p>{{ dateLabel }}</p><p>{{ event.venueName }}{% if event.venueName %}<br>{% endif %}{{ event.city }}, {{ event.region }}</p><a class="button button-primary" href="#getting-here">Venue &amp; directions <span aria-hidden="true">↗</span></a>
{% else %}
{% if event.registrationMode == 'rsvp-approval' %}<p>Organizer approval is required. Your RSVP request does not grant admission. Your QR appears in the Pluto app after approval.{% if event.venueVisibility == 'holders' %} Private venue details appear {% if event.locationRevealLabel %}at the scheduled location reveal time, once your RSVP is approved{% else %}after approval{% endif %}.{% endif %}</p>{% elif event.rsvp %}<p>Free RSVP. Your admission QR appears in the Pluto app immediately after confirmation.</p>{% endif %}
<form id="native-checkout-form"><div id="ticket-choices">{% for offer in event.offers %}<label class="ticket-choice" for="offer-{{ offer.id }}"><span><strong>{{ offer.name }}</strong><span>{{ offer.description }}</span><span>{% if event.rsvp %}Free · One pass per person{% else %}${{ offer.priceLabel }} · Price includes applicable tax{% endif %}</span>{% if not offer.available %}<span>{{ offer.availability }}</span>{% endif %}</span><select id="offer-{{ offer.id }}" name="{{ offer.id }}" {% if not offer.available or preview %}disabled{% endif %} data-ticket-quantity data-price="{{ offer.unitAmount }}" aria-label="{{ offer.name }} quantity"><option value="0">0</option>{% for quantity in range(1, offer.quantityLimit + 1) %}<option value="{{ quantity }}">{{ quantity }}</option>{% endfor %}</select></label>{% if offer.waitlistAllowed and not preview %}<button class="button button-quiet" type="button" data-waitlist-offer="{{ offer.id }}">Join {{ offer.name }} waitlist</button>{% endif %}{% endfor %}</div><div id="event-waitlist-status" aria-live="polite"></div>
{% if not event.rsvp %}<label>Promo code <input name="promoCode" maxlength="40" autocomplete="off"></label>{% endif %}<label>Full name <input name="buyerName" autocomplete="name" maxlength="150" required></label><label>{% if event.rsvp %}Email{% else %}Purchase email{% endif %} <input name="email" type="email" autocomplete="email" maxlength="254" required></label>
<p id="ticket-total">{% if event.rsvp %}Choose one RSVP admission pass above.{% else %}Select your tickets above.{% endif %}</p><button class="button button-primary" type="submit" {% if preview or (state != 'Tickets available' and state != 'RSVPs open') %}disabled{% endif %}>{% if event.registrationMode == 'rsvp-approval' %}Request RSVP{% elif event.rsvp %}Confirm RSVP{% else %}Continue to payment{% endif %}</button><p id="ticket-checkout-message" role="status" aria-live="polite"></p><p class="ticket-fineprint">{% if event.rsvp %}Your RSVP pass stays in the Pluto app and belongs to the named attendee. It cannot be transferred. Bring a photo ID. Each person must RSVP separately.{% else %}All ticket sales are final. Refund exceptions are at Pluto's discretion. Tickets stay in the Pluto app. Transfers close at first admission. Festival re-entry uses a wristband.{% endif %}</p><a href="/app/tickets">{% if event.rsvp %}View my RSVP{% else %}Already have tickets?{% endif %}</a></form>
<div id="stripe-checkout"></div><p id="checkout-countdown" role="status"></p><button id="checkout-cancel" class="button button-quiet" hidden type="button">Return to tickets</button>
{% endif %}</aside></div><a class="native-sticky-cta button button-primary" href="{% if event.free %}#event-info{% else %}#tickets{% endif %}">{{ state }} ↗</a>
</div>{% if not event.free %}<script type="application/json" id="native-checkout-config">{{ checkoutJson | safe }}</script><dialog id="ticketing-dialog" aria-label="Ticketing actions"><button id="ticketing-dialog-close" class="button button-quiet" type="button">Close</button><div id="ticketing-dialog-content"></div></dialog><script src="/assets/ticketing.js" defer></script>{% endif %}
{% endblock %}
