{% extends 'base.njk' %}
{% block content %}
<link rel="stylesheet" href="/assets/ticketing.css">
<div class="native-event theme-{{ event.theme.preset }}" style="--event-accent:{{ event.theme.accent }};--event-accent-text:{{ accentText }};--event-font:'{{ event.theme.font }}'">
{% if preview %}<p class="ticket-notice">Private preview · Checkout is disabled</p>{% elif sandbox %}<p class="ticket-notice">Sandbox event · Test payments only</p>{% endif %}
<section class="native-hero">
{% if event.hero %}<img class="native-hero-art" src="{{ event.hero.url }}" alt="{{ event.hero.alt }}" style="object-position:{{ event.hero.focalX }}% {{ event.hero.focalY }}%" fetchpriority="high">{% endif %}
<div class="native-hero-content"><p class="eyebrow">PLUTO PRESENTS · {{ state }}</p><h1>{{ event.title }}</h1><p class="native-subtitle">{{ event.subtitle }}</p><p>{{ dateLabel }}</p><p>{{ event.city }}, {{ event.region }}{% if event.venueName %} · {{ event.venueName }}{% endif %}</p><a href="#tickets" class="button button-primary">Explore tickets <span aria-hidden="true">↗</span></a></div>
</section>
<div class="native-layout"><div class="native-story">
<section class="native-section"><p class="eyebrow">THE EXPERIENCE</p><h2>A night worth being there for.</h2><div class="rich-content">{{ event.descriptionHtml | safe }}</div>
{% if event.flyer %}<figure><img class="native-flyer" src="{{ event.flyer.url }}" alt="{{ event.flyer.alt }}" loading="lazy"><figcaption>{{ event.flyer.caption }}</figcaption></figure>{% endif %}</section>
{% if event.lineup.length %}<section class="native-section"><p class="eyebrow">THE SOUND</p><h2>On the lineup.</h2><div class="native-lineup">{% for artist in event.lineup %}<article>{% if artist.image %}<img src="{{ artist.image.url }}" alt="{{ artist.image.alt }}" loading="lazy">{% endif %}<h3>{{ artist.name }}</h3><p>{{ artist.genre }}</p><p>{{ artist.time }}</p></article>{% endfor %}</div></section>{% endif %}
{% for section in event.sections %}{% if section.visible %}<section class="native-section" id="section-{{ section.id }}"><h2>{{ section.title }}</h2><div class="rich-content">{{ section.bodyHtml | safe }}</div></section>{% endif %}{% endfor %}
{% if event.gallery.length %}<section class="native-section"><h2>Get a feel for it.</h2><div class="native-gallery">{% for photo in event.gallery %}<figure><a href="{{ photo.url }}" target="_blank" rel="noopener"><img src="{{ photo.url }}" alt="{{ photo.alt }}" style="object-position:{{ photo.focalX }}% {{ photo.focalY }}%" loading="lazy"></a><figcaption>{{ photo.caption }}</figcaption></figure>{% endfor %}</div></section>{% endif %}
<section class="native-section"><h2>Getting here.</h2><p>{{ event.city }}, {{ event.region }}</p>{% if event.venueVisibility == 'holders' %}<p>The exact venue and directions are shared with ticket holders after purchase.</p>{% else %}<p>{{ event.venueName }}</p><p>{{ event.address }}</p><p class="preserve-lines">{{ event.directions }}</p>{% endif %}</section>
</div><aside class="ticket-panel" id="tickets"><p class="eyebrow">BE PART OF IT</p><h2>Your night starts here.</h2><p>{{ state }}</p>
<form id="native-checkout-form"><div id="ticket-choices">{% for offer in event.offers %}<label class="ticket-choice" for="offer-{{ offer.id }}"><span><strong>{{ offer.name }}</strong><span>{{ offer.description }}</span><span>${{ offer.priceLabel }} · Price includes applicable tax</span>{% if not offer.available %}<span>{{ offer.availability }}</span>{% endif %}</span><select id="offer-{{ offer.id }}" name="{{ offer.id }}" {% if not offer.available or preview %}disabled{% endif %} data-ticket-quantity data-price="{{ offer.unitAmount }}" aria-label="{{ offer.name }} quantity"><option value="0">0</option>{% for quantity in range(1, offer.quantityLimit + 1) %}<option value="{{ quantity }}">{{ quantity }}</option>{% endfor %}</select></label>{% endfor %}</div>
<label>Promo code <input name="promoCode" maxlength="40" autocomplete="off"></label><label>Full name <input name="buyerName" autocomplete="name" maxlength="150" required></label><label>Purchase email <input name="email" type="email" autocomplete="email" maxlength="254" required></label>
<p id="ticket-total">Select your tickets above.</p><button class="button button-primary" type="submit" {% if preview or state != 'Tickets available' %}disabled{% endif %}>Continue to payment</button><p id="ticket-checkout-message" role="status" aria-live="polite"></p><p class="ticket-fineprint">Tickets stay in the Pluto app. Transfers close at first admission. Refunds require approval. Festival re-entry uses a wristband.</p><a href="/app/tickets">Already have tickets?</a></form>
<div id="stripe-checkout"></div><p id="checkout-countdown" role="status"></p><button id="checkout-cancel" class="button button-quiet" hidden type="button">Return to tickets</button>
</aside></div><a class="native-sticky-cta button button-primary" href="#tickets">{{ state }} ↗</a>
</div><script type="application/json" id="native-checkout-config">{{ checkoutJson | safe }}</script><script src="/assets/ticketing.js" defer></script>
{% endblock %}
