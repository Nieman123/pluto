{% extends "base.njk" %}

{% block content %}
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-media" id="home-gallery" role="group" aria-roledescription="carousel" aria-label="Pluto Events photo gallery" data-gallery>
      {% set gallery = [
        { src: 'elysium-4.webp', width: 1400, height: 1120, alt: 'Three friends smiling with their arms around each other at a Pluto Events party' },
        { src: 'manafest-2026-friends.webp', width: 1743, height: 1307, position: '49% 60%', alt: 'Two friends smiling beneath colorful string lights, one wearing a mushroom hat' },
        { src: 'manafest-2026-light-canopy.webp', width: 1743, height: 1307, position: '50% 42%', alt: 'Glowing string lights and fabric canopies above the nighttime dance floor' },
        { src: 'manafest-2026-fire-fans.webp', width: 2560, height: 1707, position: '63% 25%', alt: 'A fire performer holding flaming fans overhead at ManaFest 2026' },
        { src: 'manafest-2026-dj-duo.webp', width: 2560, height: 1707, position: '50% 42%', alt: 'Two DJs performing on a stage illuminated by purple lights at ManaFest 2026' },
        { src: 'manafest-2026-disco-dj.webp', width: 2560, height: 1707, position: '54% 42%', alt: 'A DJ performing beneath a disco ball and blue light beams at ManaFest 2026' },
        { src: 'manafest-2026-dance-floor.webp', width: 2560, height: 1707, position: '50% 42%', alt: 'Attendees dancing in front of a forest stage beneath string lights at ManaFest 2026' },
        { src: 'manafest-2026-live-painting.webp', width: 2560, height: 1707, position: '59% 42%', alt: 'An artist painting beside the dance floor under purple lights at ManaFest 2026' },
        { src: 'manafest-2026-forest-overview.webp', width: 2560, height: 1707, position: '52% 42%', alt: 'A forest dance floor beneath sweeping laser beams and string lights at ManaFest 2026' },
        { src: 'manafest-2026-laser-crowd.webp', width: 2560, height: 1707, position: '60% 42%', alt: 'Festivalgoers gathered around a forest stage under blue laser beams at ManaFest 2026' },
        { src: 'manafest-2026-pink-stage.webp', width: 2560, height: 1707, position: '52% 42%', alt: 'A crowd dancing in front of a pink-lit DJ stage at ManaFest 2026' },
        { src: 'manafest-2026-crowd-closeup.webp', width: 2560, height: 1707, position: '56% 42%', alt: 'Attendees in colorful hats on the dance floor beneath purple lights at ManaFest 2026' }
      ] %}
      {% for image in gallery %}
        <img src="/gallery/{{ image.src }}" width="{{ image.width }}" height="{{ image.height }}" alt="{{ image.alt }}"{% if image.position %} style="object-position: {{ image.position }}"{% endif %} decoding="async" {% if loop.first %}loading="eager" fetchpriority="high"{% else %}hidden loading="lazy"{% endif %} data-gallery-slide>
      {% endfor %}
    </div>
    <div class="hero-shade"></div>
    <div class="hero-content">
      <p class="eyebrow">ASHEVILLE · UNDERGROUND · TOGETHER</p>
      <h1 id="home-title">PLUTO EVENTS</h1>
      <p class="hero-copy">Immersive parties and campouts built around heavy sound, local art, and the people who make the night.</p>
      <div class="hero-actions">
        <a class="button button-primary button-large" href="#events">See upcoming events</a>
        <a class="button button-glass button-large" href="/manafest">Relive ManaFest 2026</a>
      </div>
    </div>
    <div class="gallery-controls" role="group" aria-label="Photo gallery controls">
      <button type="button" data-gallery-previous aria-label="Previous photo" aria-controls="home-gallery">←</button>
      <span data-gallery-status role="status" aria-live="polite" aria-atomic="true" aria-label="Photo 1 of {{ gallery | length }}">1 / {{ gallery | length }}</span>
      <button type="button" data-gallery-next aria-label="Next photo" aria-controls="home-gallery">→</button>
    </div>
  </section>

  <section class="section events-section" id="events" aria-labelledby="events-title">
    <div class="section-heading">
      <div><p class="eyebrow">WHAT'S NEXT</p><h2 id="events-title">Upcoming events</h2></div>
      <p>Tickets, details, and everything you need before you arrive.</p>
    </div>
    <div class="event-grid">
      {% for event in events %}
        <article class="event-card" aria-labelledby="event-{{ loop.index }}-title">
          {% if event.flyerImageUrl %}
            <img class="deferred-event-image" src="/assets/images/pluto-logo.webp" data-deferred-src="{{ event.flyerImageUrl }}" width="900" height="1200" alt="{{ event.title }} event artwork" loading="lazy" decoding="async" fetchpriority="low">
          {% else %}
            <div class="event-art-fallback" aria-hidden="true">PLUTO</div>
          {% endif %}
          <div class="event-card-body">
            <h3 id="event-{{ loop.index }}-title">{% if event.ticketUrl %}<a class="event-card-link" href="{{ event.ticketUrl }}">{{ event.title }}</a>{% else %}{{ event.title }}{% endif %}</h3>
            {% if event.details %}<p>{{ event.details }}</p>{% endif %}
            {% if event.registrationMode == 'free' %}<p>Free entry · No RSVP required</p>{% endif %}
            <div class="event-actions">
              {% if event.ticketUrl %}<a class="button button-primary" href="{{ event.ticketUrl }}">{% if event.registrationMode == 'free' %}View event{% elif event.registrationMode == 'rsvp' or event.registrationMode == 'rsvp-approval' %}RSVP{% else %}Get tickets{% endif %}</a>{% endif %}
              {% if event.isManaFest %}<a class="button button-quiet" href="/manafest">ManaFest details</a>{% endif %}
            </div>
          </div>
        </article>
      {% else %}
        <p class="empty-state">New events are being prepared. Check back soon.</p>
      {% endfor %}
    </div>
  </section>

  <section class="section home-rentals" aria-labelledby="home-rentals-title">
    <div class="section-heading">
      <div><p class="eyebrow">SOUND / LIGHT / POWER</p><h2 id="home-rentals-title">Bring Pluto to your event.</h2></div>
      <p>Explore our rental equipment and get in touch about your next gathering.</p>
    </div>
    <a class="button button-primary button-large" href="/rentals">Explore rentals ↗</a>
  </section>

  <section class="statement-band" aria-labelledby="community-title">
    <p class="eyebrow">BUILT FOR PARTICIPATION</p>
    <h2 id="community-title">The crowd is part of the show.</h2>
    <p>Come expressive. Look out for each other. Leave the space better than you found it.</p>
    <a class="text-link" href="/links">Find Pluto online →</a>
  </section>
{% endblock %}
