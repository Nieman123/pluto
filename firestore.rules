rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() &&
          exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    function isManaFestLineupPublished() {
      return exists(/databases/$(database)/documents/manaFestSettings/app) &&
          get(/databases/$(database)/documents/manaFestSettings/app)
              .data
              .isLineupPublished ==
          true;
    }

    function isManaFestMapPublished() {
      return exists(/databases/$(database)/documents/manaFestSettings/app) &&
          get(/databases/$(database)/documents/manaFestSettings/app)
              .data
              .isMapPublished ==
          true;
    }

    function knownProfileKeys() {
      return [
        'displayName',
        'homeCity',
        'favoriteGenre',
        'bio',
        'profileImageDataUrl',
        'pointsBalance',
        'lifetimePoints',
        'eventsAttended',
        'createdAt',
        'updatedAt',
        'lastAttendanceAt',
        'lastRedemptionAt'
      ];
    }

    function isUserRewardInventoryDecrement() {
      let profilePath =
          /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      return signedIn() &&
          resource.data.inventory is int &&
          request.resource.data.inventory is int &&
          request.resource.data.pointsCost == resource.data.pointsCost &&
          request.resource.data.inventory == resource.data.inventory - 1 &&
          request.resource.data.diff(resource.data)
              .changedKeys()
              .hasOnly(['inventory', 'updatedAt']) &&
          exists(profilePath) &&
          existsAfter(profilePath) &&
          get(profilePath).data.pointsBalance is int &&
          getAfter(profilePath).data.pointsBalance is int &&
          (get(profilePath).data.pointsBalance -
              getAfter(profilePath).data.pointsBalance) ==
              resource.data.pointsCost;
    }

    function isUserEventQrClaimIncrement(eventQrId) {
      return signedIn() &&
          request.resource.data.totalClaims is int &&
          resource.data.totalClaims is int &&
          request.resource.data.totalClaims == resource.data.totalClaims + 1 &&
          request.resource.data.diff(resource.data)
              .changedKeys()
              .hasOnly(['totalClaims', 'updatedAt']) &&
          existsAfter(
              /databases/$(database)/documents/eventQrCodes/$(eventQrId)/claims/$(request.auth.uid));
    }

    match /adminUsers/{adminUid} {
      allow read: if isSelf(adminUid);
      allow write: if false;
    }

    match /currentEvents/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    function validRental() {
      let data = request.resource.data;
      return data.keys().hasAll(['title', 'description', 'category', 'quantity',
          'productUrl', 'imageUrl', 'priceMode', 'priceCents', 'priceUnit',
          'isActive', 'sortOrder', 'createdAt', 'updatedAt']) &&
          data.keys().hasOnly(['title', 'description', 'category', 'quantity',
          'productUrl', 'imageUrl', 'imageStoragePath', 'priceMode', 'priceCents',
          'priceUnit', 'isActive', 'sortOrder', 'createdAt', 'updatedAt']) &&
          data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
          data.description is string && data.description.size() <= 2000 &&
          data.category is string && data.category.size() > 0 && data.category.size() <= 60 &&
          data.quantity is int && data.quantity >= 1 && data.quantity <= 10000 &&
          data.sortOrder is int && data.isActive is bool &&
          data.productUrl is string && data.productUrl.size() <= 2048 &&
          (data.productUrl == '' || data.productUrl.matches('https?://.+')) &&
          data.imageUrl is string && data.imageUrl.size() <= 2048 &&
          (data.imageUrl == '' || data.imageUrl.matches('https?://.+')) &&
          (!('imageStoragePath' in data) || data.imageStoragePath is string) &&
          data.priceUnit is string && data.priceUnit.size() <= 80 &&
          ((data.priceMode == 'quote' && data.priceCents == null && data.priceUnit == '') ||
          (data.priceMode == 'price' && data.priceCents is int && data.priceCents >= 0 && data.priceCents <= 99999999)) &&
          data.createdAt is timestamp && data.updatedAt == request.time;
    }

    match /rentalItems/{rentalId} {
      allow read: if isAdmin() || resource.data.isActive == true;
      allow create, update: if isAdmin() && validRental();
      allow delete: if isAdmin();
    }

    match /rentalSettings/{settingsId} {
      allow read, write: if isAdmin();
    }

    match /rewardItems/{rewardId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isUserRewardInventoryDecrement();
    }

    match /eventQrCodes/{eventQrId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isUserEventQrClaimIncrement(eventQrId);

      match /claims/{claimUid} {
        allow read: if isSelf(claimUid) || isAdmin();
        allow create: if isSelf(claimUid) &&
            !exists(
                /databases/$(database)/documents/eventQrCodes/$(eventQrId)/claims/$(claimUid)) &&
            exists(/databases/$(database)/documents/eventQrCodes/$(eventQrId)) &&
            get(/databases/$(database)/documents/eventQrCodes/$(eventQrId)).data
                .isActive ==
                true &&
            request.resource.data.uid == claimUid &&
            request.resource.data.eventQrCodeId == eventQrId &&
            request.resource.data.pointsAwarded ==
                get(/databases/$(database)/documents/eventQrCodes/$(eventQrId))
                    .data.pointsAwarded;
        allow update, delete: if false;
      }
    }

    match /linksPageItems/{linkId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Only the server publishes allowlisted event data; ticketing ledgers remain API-only.
    match /publishedEvents/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    match /manaFestSettings/{settingsId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /manaFestScheduleItems/{scheduleItemId} {
      allow read: if isAdmin() ||
          (signedIn() &&
              resource.data.isActive == true &&
              resource.data.isPublished == true);
      allow create, update, delete: if isAdmin();
    }

    match /manaFestGuideSections/{guideSectionId} {
      allow read: if isAdmin() ||
          (signedIn() && resource.data.isActive == true);
      allow create, update, delete: if isAdmin();
    }

    match /manaFestUpdates/{updateId} {
      allow read: if isAdmin() ||
          (signedIn() && resource.data.isActive == true);
      allow create, update, delete: if isAdmin();
    }

    match /manaFestArtists/{artistId} {
      allow read: if isAdmin() ||
          (signedIn() &&
              isManaFestLineupPublished() &&
              resource.data.isActive == true &&
              resource.data.isPublished == true);
      allow create, update, delete: if isAdmin();
    }

    match /manaFestMapPins/{pinId} {
      allow read: if isAdmin() ||
          (signedIn() &&
              isManaFestMapPublished() &&
              resource.data.isActive == true &&
              resource.data.isPublished == true);
      allow create, update, delete: if isAdmin();
    }

    // Support collectionGroup('claims') analytics queries for admins.
    match /{documentPath=**}/claims/{claimUid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /userProfiles/{profileUid} {
      allow read: if isSelf(profileUid) || isAdmin();
      allow create: if isSelf(profileUid) &&
          request.resource.data.keys().hasOnly(knownProfileKeys());
      allow update: if (isSelf(profileUid) &&
              request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasOnly(knownProfileKeys())) ||
          isAdmin();
      allow delete: if false;

      match /pointsTransactions/{transactionId} {
        allow read: if isSelf(profileUid) || isAdmin();
        allow create: if isSelf(profileUid) || isAdmin();
        allow update, delete: if false;
      }

      match /redemptionRequests/{requestId} {
        allow read: if isSelf(profileUid) || isAdmin();
        allow create: if isSelf(profileUid) || isAdmin();
        allow update, delete: if isAdmin();
      }

      // Per-user anti-abuse rate-limiting state for event QR claims.
      match /claimRateLimits/{limitId} {
        allow read: if isSelf(profileUid) || isAdmin();
        allow create, update: if isSelf(profileUid) || isAdmin();
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
