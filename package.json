{
  "name": "pluto-web",
  "private": true,
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build:site": "esbuild site/src/site.js --bundle --minify --sourcemap --external:https://* --outfile=site/dist/site.js && esbuild site/src/ticketing.js --bundle --minify --sourcemap --external:https://* --outfile=site/dist/ticketing.js",
    "build:functions": "npm --prefix functions run build",
    "build:public": "npm run build:site && npm run build:functions && node scripts/compose-web.mjs",
    "test": "npm --prefix functions test && node --test test/config.test.mjs test/ticketing-financial-summary.test.mjs test/ticketing-event-schedule.test.mjs test/release-policy.test.mjs",
    "test:ci:browser": "node scripts/ci/browser-suite.mjs",
    "test:storage": "node --test test/storage-rules.test.mjs",
    "test:rentals:rules": "node --test test/rentals-rules.test.mjs",
    "test:waiver:integration": "npm --prefix functions run test:waiver:integration",
    "test:ticketing:integration": "node functions/test/ticketing-integration.cjs",
    "test:ticketing:hardening": "node --test functions/test/ticketing-hardening.cjs functions/test/offline-hardening.cjs",
    "test:ticketing:rsvp": "node functions/test/rsvp-integration.cjs",
    "test:ticketing:free": "node --test functions/test/free-events.cjs",
    "test:ticketing:rules": "node --test test/ticketing-rules.test.mjs",
    "test:rewards": "node --test functions/test/rewards-hardening.cjs && node --test test/rewards-rules.test.mjs",
    "test:rewards:browser": "node scripts/ticketing/rewards-browser-test.cjs",
    "test:ticketing:browser": "node scripts/ticketing/browser-test.cjs",
    "test:ticketing:wallet-browser": "node scripts/ticketing/wallet-browser-test.cjs",
    "test:ticketing:digital-wallet-browser": "node scripts/ticketing/digital-wallet-browser-test.cjs",
    "test:ticketing:admin-revenue-browser": "node scripts/ticketing/admin-revenue-browser-test.cjs",
    "test:ticketing:wallet-access": "node --test functions/test/wallet-access.cjs",
    "test:ticketing:location-access": "node --test functions/test/location-reveal-access.cjs",
    "test:ticketing:location-browser": "node scripts/ticketing/location-reveal-browser-test.cjs",
    "test:ticketing:checkout-account-browser": "node scripts/ticketing/checkout-account-browser-test.cjs",
    "test:ticketing:support": "node --test functions/test/operations-support.cjs functions/test/email-webhook.cjs",
    "test:ticketing:order-operations": "node --test functions/test/order-operations.cjs",
    "test:ticketing:orders-browser": "node scripts/ticketing/orders-browser-test.cjs",
    "test:ticketing:qr": "node scripts/ticketing/qr-decoder-test.cjs",
    "test:ticketing:scanner-browser": "node scripts/ticketing/scanner-pin-browser-test.cjs",
    "test:ticketing:rsvp-browser": "node scripts/ticketing/rsvp-browser-test.cjs",
    "test:ticketing:payment": "node scripts/ticketing/sandbox-payment-test.cjs",
    "preview:ticketing": "node scripts/ticketing/preview.mjs",
    "preview:ticketing:emails": "npm --prefix functions run build && node scripts/ticketing/preview-emails.mjs",
    "ticketing:key": "node scripts/ticketing/generate-signing-key.mjs",
    "ticketing:seed": "node scripts/ticketing/seed-preview.cjs",
    "ticketing:webhooks": "node scripts/ticketing/webhook-listener.mjs",
    "test:waiver:rules": "node --test test/waiver-rules.test.mjs",
    "test:waiver:browser": "node scripts/waiver/browser-test.cjs",
    "preview:waiver": "node scripts/waiver/preview.mjs"
  },
  "dependencies": {
    "@zxing/browser": "0.1.5",
    "firebase": "^12.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.63.0"
  }
}
